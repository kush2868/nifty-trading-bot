# ─── Kite Connect API ─────────────────────────────────────────────────────────
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_REDIRECT_URL=http://localhost:3000/kite/callback

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/nifty_bot

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Strategy Parameters ──────────────────────────────────────────────────────
# NIFTY lot size (65 as of 2024; verify before trading)
LOT_SIZE=65

# Number of lots per spread
LOTS_PER_SPREAD=1

# Maximum simultaneous calendar spreads allowed
MAX_SPREADS=3

# Capital allocated per spread (INR) — used for PnL % calculation
CAPITAL_PER_SPREAD=40000

# NIFTY strike gap
STRIKE_GAP=50

# Buffer before break-even to trigger adjustment (points)
ADJUSTMENT_BUFFER=50

# ─── Risk Parameters ──────────────────────────────────────────────────────────
# Exit if profit >= this % of capital deployed
PROFIT_TARGET_PCT=2.5

# Exit if loss >= this % of capital deployed
MAX_LOSS_PCT=6

# Exit after this many calendar days from entry
MAX_HOLD_DAYS=15

# Exit if short-leg expiry is within this many days
EXPIRY_EXIT_DAYS=5

# ─── Order Execution ──────────────────────────────────────────────────────────
# Maximum retry attempts for failed orders
ORDER_RETRY_ATTEMPTS=3

# Delay between retries (milliseconds)
ORDER_RETRY_DELAY_MS=2000

# Limit order price offset from LTP (paise / 100 = INR)
LIMIT_ORDER_OFFSET=0.5

# ─── Alerts (optional webhook, e.g. Slack, Discord, Telegram) ─────────────────
ALERT_WEBHOOK_URL=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
