    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "dotenv": "^16.4.5",
    "ws": "^8.17.0",
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "socket.io": "^4.7.5",
    "express-async-errors": "^3.1.1",
    "uuid": "^9.0.1"
