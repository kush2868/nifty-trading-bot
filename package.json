{
  "name": "nifty-trading-bot",
  "version": "1.0.0",
  "description": "Automated NIFTY Options Calendar Spread Trading Bot via Zerodha Kite Connect",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
